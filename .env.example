# ---- Aplikasi ----
APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Jakarta

# ---- Database (Supabase: Project Settings > Database > Connection pooling, mode transaction) ----
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Runtime aplikasi: role app_runtime, Transaction pooler, port 6543
DATABASE_URL=postgresql://app_runtime.xxxxx:PASSWORD_APP@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Migrasi: role postgres, Session pooler, port 5432
DATABASE_URL_MIGRATE=postgresql://postgres.xxxxx:PASSWORD_POSTGRES@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---- Auth ----
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email Anda sendiri, pisahkan dengan koma bila perlu
ALLOWED_EMAILS=you@gmail.com

# ---- Ruang privat ----
# Generate: openssl rand -base64 32
PRIVATE_PIN_PEPPER=
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# ---- Cron ----
# Generate: openssl rand -base64 32
CRON_SECRET=

# ---- Observability ----
SENTRY_DSN=